DATABASE_URL=postgresql://polya:polya@localhost:5432/polya
# Тесты очищают таблицы, поэтому у них своя база; имя должно кончаться на _test.
TEST_DATABASE_URL=postgresql://polya:polya@localhost:5432/polya_test
APP_URL=http://localhost:3000
# Адреса через запятую: эти пользователи могут создавать курсы.
TEACHER_EMAILS=teacher@example.com
# Без SMTP_URL письма со ссылкой входа выводятся в лог сервера.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Поля <no-reply@example.com>
# Часовой пояс для дедлайнов.
APP_TIMEZONE=Europe/Moscow
# Сервис разбора PDF (pdf-service/) и каталог для загруженных файлов.
PDF_SERVICE_URL=http://localhost:8000
STORAGE_DIR=./storage
