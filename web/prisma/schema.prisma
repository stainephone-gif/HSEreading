generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  // Может создавать курсы. Выставляется при входе по списку TEACHER_EMAILS.
  isTeacher Boolean  @default(false)
  createdAt DateTime @default(now())

  sessions       Session[]
  memberships    CourseMember[]
  ownedCourses   Course[]        @relation("CourseOwner")
  texts          Text[]
  readingCursors ReadingCursor[]
  dwells         Dwell[]
  taskPlacements TaskPlacement[]
  answers        Answer[]
  kioskExports   KioskExport[]
  kioskReports   KioskReport[]
}

// Одноразовая ссылка для входа. В базе лежит только хэш токена.
model LoginToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  // Куда вернуть пользователя после входа (относительный путь).
  next      String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Course {
  id        String   @id @default(cuid())
  title     String
  ownerId   String
  owner     User     @relation("CourseOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())

  members CourseMember[]
  invites Invite[]
  texts   Text[]
}

enum CourseRole {
  TEACHER
  STUDENT
}

model CourseMember {
  courseId String
  course   Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     CourseRole
  joinedAt DateTime   @default(now())

  @@id([courseId, userId])
  @@index([userId])
}

// Ссылка-приглашение студентов в курс. Одна ссылка на много студентов.
model Invite {
  id        String     @id @default(cuid())
  code      String     @unique
  courseId  String
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  role      CourseRole @default(STUDENT)
  revokedAt DateTime?
  createdAt DateTime   @default(now())
}

enum TextStatus {
  PROCESSING
  READY
  FAILED
}

enum DisplayMode {
  PDF
  WEB
}

// Текст для чтения: исходный PDF и его разбивка на фрагменты.
model Text {
  id             String      @id @default(cuid())
  courseId       String
  course         Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title          String
  status         TextStatus  @default(PROCESSING)
  // Сообщение для преподавателя, если разбор не удался.
  error          String?
  // Ключ файла в хранилище.
  pdfKey         String
  pdfName        String
  pageCount      Int         @default(0)
  // Размеры страниц в пунктах: [{ width, height }].
  pages          Json        @default("[]")
  language       String?
  displayMode    DisplayMode @default(PDF)
  // Норма чтения: от неё считается время, после которого открывается маркер.
  wordsPerMinute Int         @default(200)
  uploadedById   String
  uploadedBy     User        @relation(fields: [uploadedById], references: [id])
  // Пока текст не опубликован, студенты его не видят, а преподаватель правит разбивку.
  publishedAt    DateTime?
  // До дедлайна студент может отвечать на найденные задания и менять ответы.
  deadline       DateTime?
  createdAt      DateTime    @default(now())

  fragments    Fragment[]
  readers      ReadingCursor[]
  tasks        Task[]
  kioskExports KioskExport[]

  @@index([courseId])
}

enum FragmentKind {
  BODY
  HEADING
  EXCLUDED
}

// Абзац текста. На абзацы опираются задания, пасхалки и учёт дочитывания.
model Fragment {
  id            String       @id @default(cuid())
  textId        String
  text          Text         @relation(fields: [textId], references: [id], onDelete: Cascade)
  position      Int
  kind          FragmentKind
  content       String
  language      String
  wordCount     Int
  // Строки в PDF: [{ page, bbox: [x0, y0, x1, y1], start, end }], start/end — смещения в content.
  lines         Json
  // Предложения: [[start, end], ...] по смещениям в content.
  sentences     Json
  excludeReason String?

  dwells         Dwell[]
  anchoredTasks  Task[]          @relation("TaskFragment")
  sectionTasks   Task[]          @relation("TaskSection")
  taskPlacements TaskPlacement[]

  @@index([textId, position])
}

// Где студент в тексте: время последнего отчёта читалки. По нему сервер
// ограничивает засчитанное время реально прошедшим.
model ReadingCursor {
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  textId        String
  text          Text     @relation(fields: [textId], references: [id], onDelete: Cascade)
  firstOpenedAt DateTime @default(now())
  lastBeatAt    DateTime @default(now())
  // Сколько времени в читалке хотя бы один абзац был в зоне чтения.
  activeMs      Int      @default(0)

  @@id([userId, textId])
}

// Сколько времени фрагмент провёл в зоне чтения у студента.
model Dwell {
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fragmentId String
  fragment   Fragment  @relation(fields: [fragmentId], references: [id], onDelete: Cascade)
  ms         Int       @default(0)
  // Когда набралась половина расчётного времени чтения: с этого момента фрагмент дочитан.
  readAt     DateTime?

  @@id([userId, fragmentId])
  @@index([fragmentId])
}

enum TaskMode {
  // Привязано к абзацу: одно место у всех студентов.
  ANCHORED
  // Раскидано по разделу или диапазону страниц: у каждого студента свой абзац.
  SCATTERED
}

enum AnswerFormat {
  CHOICE
  SELECTION
  SHORT
}

// Спрятанное задание. Открывается студенту, когда его абзац дочитан.
model Task {
  id                String       @id @default(cuid())
  textId            String
  text              Text         @relation(fields: [textId], references: [id], onDelete: Cascade)
  mode              TaskMode
  format            AnswerFormat
  prompt            String
  // ANCHORED: абзац задания.
  fragmentId        String?
  fragment          Fragment?    @relation("TaskFragment", fields: [fragmentId], references: [id], onDelete: Restrict)
  // SCATTERED: раздел (заголовок, до следующего заголовка) или диапазон страниц (с 1).
  sectionFragmentId String?
  sectionFragment   Fragment?    @relation("TaskSection", fields: [sectionFragmentId], references: [id], onDelete: Restrict)
  pageFrom          Int?
  pageTo            Int?
  // CHOICE: варианты [{ text, correct }].
  options           Json?
  // SELECTION: эталонное предложение как смещения [start, end] в тексте абзаца.
  answerRange       Json?
  createdAt         DateTime     @default(now())

  placements TaskPlacement[]
  answers    Answer[]

  @@index([textId])
}

// Абзац, в который раскиданное задание попало у конкретного студента.
model TaskPlacement {
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fragmentId String
  fragment   Fragment @relation(fields: [fragmentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([taskId, userId])
}

enum Grade {
  PASS
  FAIL
}

model Answer {
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // CHOICE: { choice: номер }, SELECTION: { range: [start, end] }, SHORT: { text }.
  value       Json
  // Итог проверки: автоматической (CHOICE, SELECTION) или преподавателя (SHORT).
  grade       Grade?
  gradedAt    DateTime?
  submittedAt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@id([taskId, userId])
}

// Офлайн-читалка (киоск): HTML-файл с текстом и заданиями, который рассылается
// студентам. Отчёты студентов шифруются открытым ключом выгрузки, а подписываются
// ключом, спрятанным в файле; ключи расшифровки и проверки лежат только здесь.
model KioskExport {
  id          String   @id @default(cuid())
  textId      String
  text        Text     @relation(fields: [textId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  publicKey   Bytes
  secretKey   Bytes
  macKey      Bytes
  localKey    Bytes
  createdAt   DateTime @default(now())

  reports KioskReport[]

  @@index([textId])
}

// Загруженный преподавателем отчёт киоска. Повторная загрузка того же файла
// ничего не меняет: данные сливаются по максимуму.
model KioskReport {
  id          String      @id @default(cuid())
  exportId    String
  export      KioskExport @relation(fields: [exportId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Копия киоска (браузер), из которой пришёл отчёт.
  instanceId  String
  // Время сохранения отчёта по часам студента.
  savedAt     DateTime
  readCount   Int
  answerCount Int
  // SHA-256 файла: один и тот же файл не записывается дважды.
  digest      String      @unique
  importedAt  DateTime    @default(now())

  @@index([exportId, userId])
}
