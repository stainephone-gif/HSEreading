{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["node"],
    // Общий с веб-приложением код (читалка, шифрование) берётся из ../web/src,
    // а его зависимости — из node_modules этой папки.
    "paths": {
      "@/*": ["../web/src/*"],
      "~/*": ["./src/*"],
      "*": ["./node_modules/@types/*", "./node_modules/*"]
    }
  },
  "include": ["src", "tests", "*.ts", "../web/src/types"]
}
