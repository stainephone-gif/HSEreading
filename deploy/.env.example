# Скопируйте в файл .env рядом с docker-compose.yml и заполните.

# Домен сервера. Нет своего домена — подойдёт <IP-адрес>.sslip.io, например 203.0.113.10.sslip.io.
DOMAIN=polya.example.ru
# Адрес сайта для ссылок в письмах: https:// + DOMAIN.
APP_URL=https://polya.example.ru

# Пароль базы данных: длинная случайная строка (например, вывод `openssl rand -hex 24`).
POSTGRES_PASSWORD=замените-на-случайную-строку

# Почты преподавателей через запятую: только они могут создавать курсы.
TEACHER_EMAILS=you@hse.ru,colleague@hse.ru

# Почта для писем со ссылкой входа. Пример для Яндекс Почты с паролем приложения:
# SMTP_URL=smtps://login%40yandex.ru:пароль-приложения@smtp.yandex.ru:465
# Символ @ в логине записывается как %40. Без SMTP_URL ссылки пишутся в лог: docker compose logs web
SMTP_URL=
MAIL_FROM=Поля <login@yandex.ru>

APP_TIMEZONE=Europe/Moscow
